{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=ErpDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Database": {
    "MigrateOnStartup": false,
    "EnableSensitiveDataLogging": false
  },

  "Jwt": {
    "Key": "CHANGE_ME__use_user_secrets_or_a_vault__min_32_chars",
    "Issuer": "ERP.Api",
    "Audience": "ERP.Client",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Localization": {
    "ResourcesPath": "Localization/Resources",
    "DefaultCulture": "ar",
    "SupportedCultures": [ "ar", "en" ],
    "ReloadOnChange": true
  },

  "Seed": {
    "Administrator": {
      "UserName": "admin",
      "Email": "admin@erp.local",
      "TenantId": "00000000-0000-0000-0000-000000000000"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/erp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] [{UserId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "AllowedHosts": "*"
}
